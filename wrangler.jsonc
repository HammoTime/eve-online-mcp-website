{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eve-online-website-prod",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
  },
  // Domains and workers.dev are managed once by an administrator.
  // CI uses versions upload/deploy and must not reconcile account/zone settings.
}
