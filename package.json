{
  "name": "eve-online-mcp-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.8.1"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8877",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler versions upload --dry-run --outdir dist",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.5.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "wrangler": "4.136.3"
  }
}
